@{
    ViewData["Title"] = "Início";
}

<div class="text-center mb-5">
    <h1 class="display-5 fw-bold" style="color: #003366;">Sistema de Gestão de Consultas UVV</h1>
    <p class="lead text-muted">Gerencie suas consultas médicas e profissionais de forma simples e segura.</p>
</div>

<div class="row g-4">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-calendar-plus fs-1 text-primary"></i>
                    <h5 class="card-title mt-3">Nova Consulta</h5>
                    <p class="card-text text-muted">Agende uma nova consulta médica ou profissional.</p>
                    <a asp-controller="Consultas" asp-action="Create" class="btn btn-primary">Agendar</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-calendar-check fs-1 text-success"></i>
                    <h5 class="card-title mt-3">Minhas Consultas</h5>
                    <p class="card-text text-muted">Visualize e gerencie todas as suas consultas agendadas.</p>
                    <a asp-controller="Consultas" asp-action="Index" class="btn btn-outline-primary">Ver Consultas</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-box-arrow-in-right fs-1 text-primary"></i>
                    <h5 class="card-title mt-3">Login</h5>
                    <p class="card-text text-muted">Acesse sua conta para gerenciar consultas.</p>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Entrar</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-person-plus fs-1 text-success"></i>
                    <h5 class="card-title mt-3">Cadastro</h5>
                    <p class="card-text text-muted">Crie uma nova conta para começar a usar o sistema.</p>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary">Cadastrar</a>
                </div>
            </div>
        </div>
    }
</div>