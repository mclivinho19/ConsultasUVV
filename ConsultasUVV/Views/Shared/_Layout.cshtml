<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UVV Consultas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="sidebar d-flex flex-column p-3 text-white">
            <a href="/" class="d-flex align-items-center justify-content-center me-md-auto text-white text-decoration-none">
                <span class="fs-4 fw-bold">UVV Consultas</span>
            </a>
            <hr class="text-white-50">
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a class="nav-link @(Context.Request.Path == "/" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door"></i> Início
                    </a>
                </li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Consultas") ? "active" : "")" asp-controller="Consultas" asp-action="Index">
                            <i class="bi bi-calendar-check"></i> Minhas Consultas
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Account/Login") ? "active" : "")" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Path.StartsWithSegments("/Account/Register") ? "active" : "")" asp-controller="Account" asp-action="Register">
                            <i class="bi bi-person-plus"></i> Cadastro
                        </a>
                    </li>
                }
            </ul>
            <hr class="text-white-50">
            <div class="dropdown">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle fs-4 me-2"></i>
                        <span>@User.Identity.Name</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark text-small shadow">
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item">
                                    <i class="bi bi-box-arrow-right me-2"></i>Sair
                                </button>
                            </form>
                        </li>
                    </ul>
                }
                else
                {
                    <span class="text-white-50 small">Não autenticado</span>
                }
            </div>
        </nav>
    </header>

    <div class="main-content container-fluid">
        <main role="main" class="px-4 py-3">
            @RenderBody()
        </main>
        <footer class="footer mt-auto py-3">
            <div class="container-fluid">
                <span class="text-muted">&copy; 2026 - UVV Consultas - Sistema de Gestão de Consultas</span>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>