			"item": [
				{
					"name": "Register (POST)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded",
								"type": "text"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "Nome",
									"value": "Maria Silva",
									"type": "text"
								},
								{
									"key": "Email",
									"value": "maria@example.com",
									"type": "text"
								},
								{
									"key": "Senha",
									"value": "Senha123!",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/Account/Register",
							"host": ["{{baseUrl}}"],
							"path": ["Account", "Register"]
						},
						"description": "Cadastra um novo usuário. Se bem-sucedido, redireciona (302) para /Consultas. É necessário lidar com cookies."
					},
					"response": []
				},
				{
					"name": "Login (POST)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded",
								"type": "text"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "email",
									"value": "maria@example.com",
									"type": "text"
								},
								{
									"key": "senha",
									"value": "Senha123!",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/Account/Login",
							"host": ["{{baseUrl}}"],
							"path": ["Account", "Login"]
						},
						"description": "Autentica o usuário. Em caso de sucesso, define um cookie de autenticação e redireciona para /Consultas."
					},
					"response": []
				},
				{
					"name": "Logout (POST)",
					"request": {
						"method": "POST",
						"header": [],
