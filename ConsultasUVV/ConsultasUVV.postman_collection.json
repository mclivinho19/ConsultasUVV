						},
						"url": {
							"raw": "{{baseUrl}}/Consultas/Delete/1",
							"host": ["{{baseUrl}}"],
							"path": ["Consultas", "Delete", "1"]
						},
						"description": "Exclui a consulta ID=1. Necessário autenticação e token CSRF."
