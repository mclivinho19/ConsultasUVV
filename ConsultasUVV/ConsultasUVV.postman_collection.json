							"raw": "{{baseUrl}}/Account/Logout",
							"host": ["{{baseUrl}}"],
							"path": ["Account", "Logout"]
						},
						"description": "Encerra a sessão. Requer cookie de autenticação e token anti-CSRF (se presente)."
					},
					"response": []
				}
			]
		},
